# Copy to .env.local (Next dev) and .dev.vars (Wrangler preview). Never commit real values.

# Public origin of the site (canonical URLs, sitemap). Domain decided in D-2.
# NEXT_PUBLIC_SITE_URL=https://extraconsult.bg

# Resend (FR-8, FR-11). Until the domain is verified, Resend only sends from
# onboarding@resend.dev to the Resend account's own address.
RESEND_API_KEY=
LEAD_FROM_EMAIL=
LEAD_TO_EMAIL=

# Google Sheet via Apps Script web app (FR-9) — setup steps in scripts/lead-sheet.gs
SHEET_WEBHOOK_URL=
SHEET_SECRET=

# Cloudflare Turnstile (FR-4). Local testing with Cloudflare's public test keys:
#   site key 1x00000000000000000000BB (invisible, always passes)
#   secret   1x0000000000000000000000000000000AA (always passes)
#            2x0000000000000000000000000000000AA (always fails — shows the error state)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Tracking (FR-28, FR-29). Public IDs, not secrets; leave empty to load nothing.
# Meta Pixel and Google Ads load only after the visitor accepts marketing cookies.
# Google Ads conversion = view of /blagodarim; the label comes from the conversion action.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=
# Cloudflare Web Analytics site token (cookieless, needs no consent).
NEXT_PUBLIC_CF_BEACON_TOKEN=

# Local testing only: "1" accepts requests without sending email or writing the Sheet.
# Ignored unless the request goes to localhost.
LEAD_DRY_RUN=
