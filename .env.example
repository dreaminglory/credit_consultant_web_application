# Template only: variable names, never real values (this file is committed).
#
# Where the real values go:
#   .env.local             `npm run dev` on your machine — use the test values below
#   .dev.vars              `npm run preview` (local Workers runtime) — server values only
#   .env.production.local  `npm run deploy` build — the PUBLIC (NEXT_PUBLIC_*) production values
#   Cloudflare secrets     production server values: `npx wrangler secret put <NAME>`
# All of these except Cloudflare are git-ignored. Keep production secrets in a password manager.
#
# NEXT_PUBLIC_* values are baked into the build: `npm run deploy` reads them from
# .env.production.local, which overrides .env.local, so the live site never gets test keys.
# `npm run preview` is a production build too, so it uses the same values.

# Public origin of the site (canonical URLs, sitemap, Open Graph). Production (D-2):
# NEXT_PUBLIC_SITE_URL=https://extraconsultbg.com
NEXT_PUBLIC_SITE_URL=

# Search engines may index the site only when "true". Leave empty until launch (M10).
NEXT_PUBLIC_ALLOW_INDEXING=

# Resend (FR-8, FR-11). Until the domain is verified, Resend only sends from
# onboarding@resend.dev to the Resend account's own address.
RESEND_API_KEY=
LEAD_FROM_EMAIL=
LEAD_TO_EMAIL=

# Google Sheet via Apps Script web app (FR-9) — setup steps in scripts/lead-sheet.gs
SHEET_WEBHOOK_URL=
SHEET_SECRET=

# Cloudflare Turnstile (FR-4). Local testing with Cloudflare's public test keys:
#   site key 1x00000000000000000000BB (invisible, always passes)
#   secret   1x0000000000000000000000000000000AA (always passes)
#            2x0000000000000000000000000000000AA (always fails — shows the error state)
# Production keys only work on the hostnames listed on the widget (extraconsultbg.com, www).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Tracking (FR-28, FR-29). Public IDs, not secrets; leave empty to load nothing.
# Meta Pixel and Google Ads load only after the visitor accepts marketing cookies.
# Google Ads conversion = view of /blagodarim; the label comes from the conversion action.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=
# Cloudflare Web Analytics site token (cookieless, needs no consent).
NEXT_PUBLIC_CF_BEACON_TOKEN=

# Local testing only: "1" accepts requests without sending email or writing the Sheet.
# Ignored unless the request goes to localhost. Never set it in production.
LEAD_DRY_RUN=
