{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "extraconsult-website",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      // Self-reference service binding; the service name must match the worker name.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "extraconsult-website",
    },
  ],
  // Consultation requests per visitor IP (TR-10): 5 per minute.
  "ratelimits": [
    {
      "name": "LEAD_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 },
    },
  ],
  "observability": { "enabled": true },
  // Production domain (D-2). Custom domains get their DNS record and certificate on deploy;
  // www is redirected to the apex by a Cloudflare Redirect Rule. No public workers.dev copy.
  "routes": [
    { "pattern": "extraconsultbg.com", "custom_domain": true },
    { "pattern": "www.extraconsultbg.com", "custom_domain": true },
  ],
  "workers_dev": false,
  "preview_urls": false,
}
